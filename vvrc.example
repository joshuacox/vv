#!/usr/bin/env bash
# Example configuration for vv (~/.config/vv/config or ~/.vvrc)

# Niceness settings (defined before VV_PRE so they expand properly)
: ${VV_NICENESS:="11"}
: ${VV_IO_NICENESS:="2"}

# Post-command sync (1 = enable, 0 = disable)
: ${VV_SYNC:="1"}

# Desktop notifications (1 = enable via notify-send/osascript, 0 = disable)
: ${VV_NOTIFY:="1"}

# Fallback terminal bell if audio player/sound is unavailable (1 = enable, 0 = disable)
: ${VV_BELL:="1"}

# Custom command prefix (if unset, automatically configured using available nice/ionice/time)
# : ${VV_PRE:="nice -n${VV_NICENESS} ionice -c${VV_IO_NICENESS}"}

# Specific player to use (e.g. 'aplay -q', 'paplay', 'pw-play', 'afplay', 'mpv')
# : ${VV_PLAYER:="paplay"}

# Specific sound files for success vs. failure
# : ${VV_SUCCESS_SOUND:="/usr/share/sounds/freedesktop/stereo/complete.oga"}
# : ${VV_FAILURE_SOUND:="/usr/share/sounds/freedesktop/stereo/dialog-error.oga"}

# Override all completion sounds with a single specific sound file
# : ${VV_PLAYFILE:="/usr/share/sounds/freedesktop/stereo/phone-incoming-call.oga"}
