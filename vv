#!/usr/bin/env bash
# vv - A polite wrapper for command line tasks that alerts when done

VV_VERSION="0.2.0"

srcr () {
  local target="$1"
  if [[ -f "${target}" ]]; then
    source "${target}"
  fi
}

# Configuration file search paths (XDG compliant with fallbacks)
srcr "${XDG_CONFIG_HOME:-$HOME/.config}/vv/config"
srcr "$HOME/.vv/config"
srcr "$HOME/.vvrc"

usage () {
  cat <<'EOF'
Usage: vv [options] <command> [args...]

A wrapper around long-running commands to run politely with nice/ionice,
time execution, sync filesystems, and sound an alert upon completion.

Options:
  -h, --help       Show this help message and exit
  -v, --version    Show version information and exit

Environment Variables:
  VV_NICENESS        CPU nice level (default: 19)
  VV_IO_NICENESS     I/O nice class/level (default: 3)
  VV_SYNC            Perform 'sync' after command (default: 1, set 0 to disable)
  VV_NOTIFY          Send desktop notification on completion (default: 1, set 0 to disable)
  VV_BELL            Emit terminal bell if no audio player found (default: 1, set 0 to disable)
  VV_PLAYER          Explicit audio player command (e.g. 'aplay', 'paplay')
  VV_PLAYFILE        Explicit sound file to play on completion
  VV_SUCCESS_SOUND   Sound file for successful command exit
  VV_FAILURE_SOUND   Sound file for failed command exit
  VV_PRE             Command prefix (overrides automatic nice/ionice/time)

Examples:
  vv apt-get update
  vv make -j$(nproc)
  VV_SYNC=0 vv cargo build
EOF
}

# Handle options and missing arguments
if [[ $# -eq 0 ]]; then
  usage >&2
  exit 1
fi

case "$1" in
  -h|--help)
    usage
    exit 0
    ;;
  -v|--version)
    echo "vv version ${VV_VERSION}"
    exit 0
    ;;
esac

# Overridable default settings
: ${VV_NICENESS:="19"}
: ${VV_IO_NICENESS:="3"}
: ${VV_SYNC:="1"}
: ${VV_NOTIFY:="1"}
: ${VV_BELL:="1"}

# Build default command prefix if not explicitly set
if [[ -z ${VV_PRE+x} ]]; then
  _PRE_PARTS=()
  if [[ -x /usr/bin/time ]]; then
    _PRE_PARTS+=(/usr/bin/time -v)
  fi
  if command -v nice >/dev/null 2>&1; then
    _PRE_PARTS+=(nice -n "${VV_NICENESS}")
  fi
  if command -v ionice >/dev/null 2>&1; then
    _PRE_PARTS+=(ionice -c "${VV_IO_NICENESS}")
  fi
  VV_PRE="${_PRE_PARTS[*]}"
fi

alertr () {
  local exit_code="${1:-0}"
  local cmd_name="${2:-command}"

  # Desktop notification
  if [[ "${VV_NOTIFY}" != "0" ]]; then
    if command -v notify-send >/dev/null 2>&1; then
      if [[ ${exit_code} -eq 0 ]]; then
        notify-send -i dialog-information "vv: Command succeeded" "${cmd_name}" >/dev/null 2>&1 || true
      else
        notify-send -u critical -i dialog-error "vv: Command failed (${exit_code})" "${cmd_name}" >/dev/null 2>&1 || true
      fi
    elif command -v osascript >/dev/null 2>&1; then
      if [[ ${exit_code} -eq 0 ]]; then
        osascript -e "display notification \"${cmd_name}\" with title \"vv: Command succeeded\"" >/dev/null 2>&1 || true
      else
        osascript -e "display notification \"${cmd_name} (${exit_code})\" with title \"vv: Command failed\"" >/dev/null 2>&1 || true
      fi
    fi
  fi

  # Auto-detect audio player if not configured
  if [[ -z ${VV_PLAYER+x} ]]; then
    if command -v canberra-gtk-play >/dev/null 2>&1; then
      VV_PLAYER="canberra-gtk-play -f"
    elif command -v paplay >/dev/null 2>&1; then
      VV_PLAYER="paplay"
    elif command -v pw-play >/dev/null 2>&1; then
      VV_PLAYER="pw-play"
    elif command -v afplay >/dev/null 2>&1; then
      VV_PLAYER="afplay"
    elif command -v aplay >/dev/null 2>&1; then
      VV_PLAYER="aplay -q"
    elif command -v ogg123 >/dev/null 2>&1; then
      VV_PLAYER="ogg123 -q"
    elif command -v mpv >/dev/null 2>&1; then
      VV_PLAYER="mpv --no-terminal --really-quiet"
    elif command -v ffplay >/dev/null 2>&1; then
      VV_PLAYER="ffplay -nodisp -autoexit -loglevel quiet"
    elif command -v cvlc >/dev/null 2>&1; then
      VV_PLAYER="cvlc --no-loop --no-repeat --play-and-exit --quiet"
    elif command -v mplayer >/dev/null 2>&1; then
      VV_PLAYER="mplayer -really-quiet"
    fi
  fi

  # Determine candidate sound files based on exit code
  local candidate_sounds=()
  if [[ ${exit_code} -eq 0 ]]; then
    if [[ -n ${VV_SUCCESS_SOUND+x} ]]; then
      candidate_sounds+=("${VV_SUCCESS_SOUND}")
    fi
    candidate_sounds+=(
      /usr/share/sounds/freedesktop/stereo/complete.oga
      /usr/share/sounds/gnome/default/alerts/string.ogg
      /usr/share/sounds/oxygen/stereo/game-over-winner.ogg
      /usr/share/sounds/freedesktop/stereo/phone-incoming-call.oga
      /usr/share/sounds/Oxygen-Im-Sms.ogg
      /usr/share/sounds/gnome/default/alerts/click.ogg
      /usr/share/sounds/alsa/Front_Center.wav
      /System/Library/Sounds/Glass.aiff
    )
  else
    if [[ -n ${VV_FAILURE_SOUND+x} ]]; then
      candidate_sounds+=("${VV_FAILURE_SOUND}")
    fi
    candidate_sounds+=(
      /usr/share/sounds/freedesktop/stereo/dialog-error.oga
      /usr/share/sounds/freedesktop/stereo/suspend-error.oga
      /usr/share/sounds/gnome/default/alerts/bark.ogg
      /usr/share/sounds/alsa/Noise.wav
      /System/Library/Sounds/Basso.aiff
      /usr/share/sounds/alsa/Front_Center.wav
    )
  fi

  # Filter candidate sounds if player has specific format constraints (e.g. aplay only plays WAV)
  if [[ -z ${VV_PLAYFILE+x} ]]; then
    local player_base
    player_base=$(echo "${VV_PLAYER}" | awk '{print $1}')
    player_base=$(basename "${player_base}")

    for s in "${candidate_sounds[@]}"; do
      if [[ -f "$s" ]]; then
        if [[ "$player_base" == "aplay" && "$s" != *.wav ]]; then
          continue
        elif [[ "$player_base" == "ogg123" && "$s" != *.og* ]]; then
          continue
        fi
        VV_PLAYFILE="$s"
        break
      fi
    done
  fi

  # Play sound or emit terminal bell fallback
  if [[ -n ${VV_PLAYER+x} && -n ${VV_PLAYFILE+x} ]]; then
    ${VV_PLAYER} "${VV_PLAYFILE}" >/dev/null 2>&1 || true
  elif [[ "${VV_BELL}" != "0" ]]; then
    printf '\a'
  fi
}

vvr () {
  local cmd_exit=0
  if [[ -n ${VV_PRE} ]]; then
    ${VV_PRE} "$@"
    cmd_exit=$?
  else
    "$@"
    cmd_exit=$?
  fi

  if [[ "${VV_SYNC}" != "0" ]]; then
    echo "now syncing"
    time sync
  fi

  return ${cmd_exit}
}

vvr "$@"
EXIT_CODE=$?

alertr "${EXIT_CODE}" "$*"

exit "${EXIT_CODE}"
